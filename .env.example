# SentinelOps AI - Environment Configuration Example

# Database URL
# For local SQLite development (default):
DATABASE_URL=sqlite:///./storage/sentinelops.db

# For production PostgreSQL:
# DATABASE_URL=postgresql://sentinel_user:secret_password@localhost:5432/sentinelops

# Application Secret Key (for future auth / JWT in Milestone 3)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
